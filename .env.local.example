# Same Google Doc template + Drive folder as Apps Script generateAndSendReports
MIS_DOC_TEMPLATE_ID=1W0V2w3-xd08FK_Zx7M37k8xOysh2KL2uqNbltbJ1PTs
MIS_REPORT_OUTPUT_FOLDER_ID=1QR7OGXtND7F6hFTuKPA6hkL06A0u2RDI
# Weekly G4 snapshots (mis_weekly) + monthly PDF rollup prefer Cloudflare D1 when
# CLOUDFLARE_API_URL is set; otherwise Firebase Firestore misWeekly.
# Apply cloudflare/d1/mis_weekly.sql on your D1 database, then redeploy the worker.
# Scoring sources: Checklist = timely Masters; Delegation = Cloudflare One Time;
# FMS = MIS Report workbook tabs. Production monthly uses mis_weekly (not sheet).
# If Cloudflare MIS write/read fails, app falls back to Firebase and WAHA-alerts this number:
MIS_FALLBACK_ALERT_WA=919967716945

# WAHA (server only)
